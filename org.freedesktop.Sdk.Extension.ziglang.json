{
    "id": "org.freedesktop.Sdk.Extension.ziglang",
    "branch": "26.08",
    "runtime": "org.freedesktop.Sdk",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "build-extension": true,
    "separate-locales": false,
    "appstream-compose": false,
    "build-options": {
        "prefix": "/usr/lib/sdk/ziglang"
    },
    "modules": [
        {
            "name": "zig",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /usr/lib/sdk/ziglang",
                "cp -r ./* /usr/lib/sdk/ziglang",
                "chmod a+x /usr/lib/sdk/ziglang/zig"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ziglang.org/download/0.17.1/zig-x86_64-linux-0.17.1.tar.xz",
                    "sha256": "3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://ziglang.org/download/index.json",
                        "version-query": "keys | map(select(test(\"^[0-9]+[.][0-9]+[.][0-9]+$\"))) | max_by(split(\".\") | map(tonumber))",
                        "url-query": ".[$version][\"x86_64-linux\"].tarball"
                    },
                    "only-arches": [
                        "x86_64"
                    ]
                },
                {
                    "type": "archive",
                    "url": "https://ziglang.org/download/0.17.1/zig-aarch64-linux-0.17.1.tar.xz",
                    "sha256": "a1546d5646eb184437918d6635ca6b762a0e889eac09cef720ee7a1ed3fe7795",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://ziglang.org/download/index.json",
                        "version-query": "keys | map(select(test(\"^[0-9]+[.][0-9]+[.][0-9]+$\"))) | max_by(split(\".\") | map(tonumber))",
                        "url-query": ".[$version][\"aarch64-linux\"].tarball"
                    },
                    "only-arches": [
                        "aarch64"
                    ]
                }
            ]
        },
        {
            "name": "scripts",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 enable.sh /usr/lib/sdk/ziglang/enable.sh"
            ],
            "sources": [
                {
                    "type": "script",
                    "commands": [
                        "export PATH=$PATH:/usr/lib/sdk/ziglang"
                    ],
                    "dest-filename": "enable.sh"
                }
            ]
        },
        {
            "name": "metainfo",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 org.freedesktop.Sdk.Extension.ziglang.metainfo.xml ${FLATPAK_DEST}/share/metainfo/org.freedesktop.Sdk.Extension.ziglang.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "org.freedesktop.Sdk.Extension.ziglang.metainfo.xml"
                }
            ]
        }
    ]
}
